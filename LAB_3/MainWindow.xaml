<Window x:Class="InterpolationLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InterpolationLab.ViewModels"
        Title="Лабораторна робота №3" Height="500" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="h1 (великий):" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding H1, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="5"/>

            <TextBlock Text="h2 (дрібний):" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding H2, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="5"/>

            <CheckBox Content="Еталон (sin)" IsChecked="{Binding ShowOriginal}" Margin="10,5"/>
            <CheckBox Content="Лінійна" IsChecked="{Binding ShowLinear}" Margin="5"/>
            <CheckBox Content="Ерміта" IsChecked="{Binding ShowHermite}" Margin="5"/>
            <CheckBox Content="Похибка" IsChecked="{Binding ShowErrorPlot}" Margin="5"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#FAFAFA">
            <Canvas ClipToBounds="True">
                <Polyline Points="{Binding ErrorPoints}" Stroke="Orange" StrokeThickness="1.5"
                          Visibility="{Binding ShowErrorPlot, Converter={StaticResource BoolToVis}}"/>
                <Polyline Points="{Binding OriginalPoints}" Stroke="Black" StrokeDashArray="2 2" StrokeThickness="1.5"
                          Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}"/>
                <Polyline Points="{Binding LinearPoints}" Stroke="Red" StrokeThickness="2"
                          Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}"/>
                <Polyline Points="{Binding HermitePoints}" Stroke="Blue" StrokeThickness="2"
                          Visibility="{Binding ShowHermite, Converter={StaticResource BoolToVis}}"/>
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <TextBlock Text="-- Еталон" Foreground="Black" Margin="10,0"/>
            <TextBlock Text="— Лінійна" Foreground="Red" Margin="10,0"/>
            <TextBlock Text="— Ерміта" Foreground="Blue" Margin="10,0"/>
            <TextBlock Text="— Похибка" Foreground="Orange" Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>